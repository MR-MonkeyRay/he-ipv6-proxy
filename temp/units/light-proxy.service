[Unit]
Description=light-proxy IPv6 source-rotating plain-HTTP forward proxy
Documentation=file://__TEMP_DIR__/../README.md
After=network-online.target he-ipv6.service light-proxy-envsetup.service
Wants=network-online.target
Requires=he-ipv6.service light-proxy-envsetup.service

[Service]
# 直接执行 temp/ 下的二进制, 配置也在 temp/ (不复制任何东西到系统目录)
ExecStart=__TEMP_DIR__/light-proxy run -c __TEMP_DIR__/config.toml
# 运行用户由 install-systemd.sh 在安装时填入(执行 sudo 的普通用户)
User=__RUN_USER__
# 固定工作目录: config 里 log.dir 的相对路径(默认 "log")按它解析
WorkingDirectory=__TEMP_DIR__
# ProtectSystem=strict 把整个文件系统挂成只读, 日志目录必须显式放行
# 路径由 install-systemd.sh 按配置里的 log.dir 填入
ReadWritePaths=__LOG_DIR__
# 代理本身不需要任何特权: FREEBIND 免 root, 监听端口 > 1024
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
# read-only 而非 yes: 仓库若真在 /home 下(本机 /home/x/workspace 是指向 /data 的符号链接,
# 已被 pwd -P 解析), 只读即可让服务读到二进制与配置, 同时仍禁止写家目录
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
# 出站 IPv6 + 解析 AAAA 所需; NETLINK 供 Go 运行时查询网络信息
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
LockPersonality=yes
Restart=on-failure
RestartSec=2s
# 2=配置错误 3=前置自检失败: 重启无用, 避免热循环
RestartPreventExitStatus=2 3

[Install]
WantedBy=multi-user.target

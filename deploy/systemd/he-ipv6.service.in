[Unit]
Description=HE 6in4 tunnel for he-ipv6-proxy IPv6 egress
Documentation=https://tunnelbroker.net/
After=network-online.target systemd-networkd.service
Wants=network-online.target
Before=he-ipv6-proxy-envsetup.service he-ipv6-proxy.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=-/usr/sbin/ip tunnel del he-ipv6
ExecStart=/usr/sbin/modprobe sit
ExecStart=/usr/sbin/ip tunnel add he-ipv6 mode sit remote __HE_SERVER_IPV4__ local __HE_CLIENT_IPV4__ ttl 255
ExecStart=/usr/sbin/ip link set he-ipv6 up mtu 1480
ExecStart=/usr/sbin/ip -6 addr add __HE_CLIENT_IPV6__ dev he-ipv6 nodad
ExecStart=/usr/sbin/ip -6 route replace default dev he-ipv6
ExecStop=-/usr/sbin/ip tunnel del he-ipv6

[Install]
WantedBy=multi-user.target

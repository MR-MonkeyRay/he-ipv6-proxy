[Unit]
Description=he-ipv6-proxy IPv6 source-rotating forward proxy
Documentation=https://github.com/MR-MonkeyRay/he-ipv6-proxy
After=network-online.target he-ipv6-proxy-envsetup.service
Wants=network-online.target
Requires=he-ipv6-proxy-envsetup.service

[Service]
ExecStart=/usr/local/bin/he-ipv6-proxy run -c /etc/he-ipv6-proxy.toml
EnvironmentFile=-/etc/he-ipv6-proxy.env
User=he-ipv6-proxy
WorkingDirectory=/var/lib/he-ipv6-proxy
ReadWritePaths=/var/lib/he-ipv6-proxy/log
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
LockPersonality=yes
Restart=on-failure
RestartSec=2s
RestartPreventExitStatus=2 3

[Install]
WantedBy=multi-user.target
